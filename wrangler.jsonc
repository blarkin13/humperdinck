{
  "name": "humperdinck",
  "main": "src/model-proxy-worker.js",
  "compatibility_date": "2026-11-03",
  "analytics_engine_datasets": [{"binding":"ANALYTICS","dataset":"humperdinck_site_events"}],
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": [
      "/model/*",
      "/analytics/event",
      "/downloads/*",
      "/downloads.json",
      "/updates/latest.json",
      "/voices/*",
      "/api/account/*"
    ]
  }
}
