{
  "name": "humperdinck",
  "main": "src/model-proxy-worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": [
      "/model/*",
      "/downloads/*",
      "/downloads.json",
      "/updates/latest.json",
      "/voices/*"
    ]
  }
}
