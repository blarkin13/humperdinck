{
  "name": "humperdinck",
  "main": "src/model-proxy-worker.js",
  "compatibility_date": "2026-11-03",
  "analytics_engine_datasets": [{"binding":"ANALYTICS","dataset":"humperdinck_site_events"}],
  "d1_databases": [{"binding":"AUTH_DB","database_name":"humperdinck-accounts","database_id":"0ccfa326-04a9-4043-9a20-6780d27d622a","migrations_dir":"migrations"}],
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": [
      "/model/*",
      "/analytics/event",
      "/downloads/*",
      "/downloads.json",
      "/updates/latest.json",
      "/voices/*",
      "/api/account/*"
    ]
  }
}
