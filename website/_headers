# HTML is always fetched fresh; Vite gives JS/CSS fingerprinted filenames.
/
  Cache-Control: no-store, max-age=0
/studio/
  Cache-Control: no-store, max-age=0
/studio/index.html
  Cache-Control: no-store, max-age=0
/index.html
  Cache-Control: no-store, max-age=0
/script.js
  Cache-Control: no-store, max-age=0
/build.json
  Cache-Control: no-store, max-age=0
/studio/assets/*
  Cache-Control: public, max-age=31536000, immutable

/studio/wasm/*
  Cache-Control: no-store, max-age=0

# Keep public search pages fresh after repository deployments.
/ai-voice-generator/*
  Cache-Control: no-store, max-age=0
/text-to-speech/*
  Cache-Control: no-store, max-age=0
/voice-cloning/*
  Cache-Control: no-store, max-age=0
/offline-ai-voice/*
  Cache-Control: no-store, max-age=0
/ai-narration/*
  Cache-Control: no-store, max-age=0
/video-voiceover/*
  Cache-Control: no-store, max-age=0
/seo-pages.css
  Cache-Control: public, max-age=3600

# Account HTML and checkout JavaScript must never use stale provider code.
/account/
  Cache-Control: no-store, max-age=0
/account/index.html
  Cache-Control: no-store, max-age=0
/account/account.js
  Cache-Control: no-store, max-age=0
/account/account-stripe-20261114.js
  Cache-Control: no-store, max-age=0

/account/account-live-20261114.js
  Cache-Control: no-store, max-age=0
